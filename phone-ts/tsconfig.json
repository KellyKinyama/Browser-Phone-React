{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "incremental": true,
    "outDir": "dist",
    "types": []
  },
  "include": ["src/**/*"]
}
