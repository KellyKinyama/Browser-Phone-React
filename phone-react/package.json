{
  "name": "browser-phone-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ground-up React + TypeScript rewrite of Browser-Phone (WebRTC SIP phone for Asterisk).",
  "scripts": {
